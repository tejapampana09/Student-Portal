# Generate independent secrets: openssl rand -hex 32
# Never reuse example/CI keys. Keep DB_ENCRYPTION_KEY stable until encrypted data is migrated.
# ==============================================================================
# SRMAP Student Portal - Environment Configuration Template
# ==============================================================================

# MongoDB Connection URIs (Required for OAuth session storage & users)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster
FORUMS_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster

# JWT Authentication
ACCESS_SECRET=

# Required application secrets (minimum 32 characters each)
DB_ENCRYPTION_KEY=

# Google Gemini AI API Key (Free tier at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 (For Gmail Sync & Google Classroom Sync)
# Get from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Application Origin URL
# For local dev: http://localhost:3000 (or http://localhost:3001)
# For production: https://srmapi.in
APP_ORIGIN=http://localhost:3001

# Comma-separated admin registration numbers
ADMIN_USERS=AP2410010724,AP24110010724
