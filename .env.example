# ==============================================================================
# SRMAP Student Portal - Environment Configuration Template
# ==============================================================================

# MongoDB Connection URIs
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Clustert
FORUMS_MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Clustert

# JWT Authentication
ACCESS_SECRET=your_super_secret_jwt_key_here

# Required application secrets (minimum 32 characters each)
DB_ENCRYPTION_KEY=replace_with_a_random_32_plus_character_secret

# Comma-separated admin registration numbers
ADMIN_USERS=AP24110010198,AP24110011130,AP24110010834,AP24110010866
