{
  "name": "Student Corner - SRM AP",
  "short_name": "Student Corner",
  "description": "Student portal for SRM University AP students to track attendance, calculate CGPA, view timetable, and access resources.",
  "id": "srmap-student-corner",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "display_override": ["standalone", "window-controls-overlay", "browser"],
  "background_color": "#090d16",
  "theme_color": "#090d16",
  "categories": ["education", "productivity"],
  "icons": [
